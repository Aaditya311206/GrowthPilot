# Database connection (PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/growthpilot?schema=public"

# Node.js backend port
PORT=3000

# AI Engine internal URL
AI_ENGINE_URL=http://localhost:8000

# LLM API Config (used by Python AI Engine)
LLM_PROVIDER=openai # or anthropic
LLM_API_KEY=your_api_key_here

# Razorpay Config (optional, for stretch goal)
RAZORPAY_KEY_ID=test_key_id
RAZORPAY_KEY_SECRET=test_key_secret
